{
  "manifest_version": 2,
  "name": "YouTube Tile View",
  "version": "0.0.3",
  "description": "Adjusts YouTube so the video player takes up the entire viewport. Squishes the masthead during video playback and eases it back in when paused or video completes.",
  "permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-tile-view@wryco.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
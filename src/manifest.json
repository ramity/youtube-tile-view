{
  "manifest_version": 2,
  "name": "YT Viewer",
  "version": "0.0.1",
  "description": "Adjusts YouTube layout so the masthead and video player take up the entire viewport, squishing the masthead during video playback and easing it in when paused.",
  "permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-viewer@wryco.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}